rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isDriver() {
      return request.auth != null
        && exists(/databases/$(database)/documents/drivers/$(request.auth.uid));
    }

    function driverRef() {
      return /databases/$(database)/documents/drivers/$(request.auth.uid);
    }

    function isTripDriver(tripData) {
      return tripData.driver_id == driverRef();
    }

    function isWaitingPassengersCreate() {
      return request.resource.data.status == 'Waiting-Passengers'
        && request.resource.data.created_at is timestamp
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.total_passengers is number
        && request.resource.data.total_passengers == 0
        && !('departure_time' in request.resource.data)
        && !('arrival_time' in request.resource.data)
        && request.resource.data.driver_id == driverRef()
        && request.resource.data.bus_id is path
        && request.resource.data.route_id is path;
    }

    function isStartTripUpdate() {
      return resource.data.status == 'Waiting-Passengers'
        && request.resource.data.status == 'On-the-way'
        && request.resource.data.departure_time is timestamp
        && !('arrival_time' in request.resource.data)
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.driver_id == resource.data.driver_id
        && request.resource.data.bus_id == resource.data.bus_id
        && request.resource.data.route_id == resource.data.route_id
        && request.resource.data.price == resource.data.price
        && request.resource.data.total_passengers == resource.data.total_passengers;
    }

    function isCompleteTripUpdate() {
      return resource.data.status == 'On-the-way'
        && request.resource.data.status == 'Arrived'
        && request.resource.data.arrival_time is timestamp
        && request.resource.data.departure_time == resource.data.departure_time
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.driver_id == resource.data.driver_id
        && request.resource.data.bus_id == resource.data.bus_id
        && request.resource.data.route_id == resource.data.route_id
        && request.resource.data.price == resource.data.price
        && request.resource.data.total_passengers == resource.data.total_passengers;
    }

    function isGuestBookingUpdate() {
      return request.auth == null
        && (resource.data.status == 'Waiting-Passengers'
          || resource.data.status == 'On-the-way')
        && request.resource.data.status == resource.data.status
        && request.resource.data.driver_id == resource.data.driver_id
        && request.resource.data.bus_id == resource.data.bus_id
        && request.resource.data.route_id == resource.data.route_id
        && request.resource.data.price == resource.data.price
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.total_passengers == resource.data.total_passengers + 1
        && (!('departure_time' in resource.data)
          || request.resource.data.departure_time == resource.data.departure_time)
        && (!('arrival_time' in resource.data)
          || request.resource.data.arrival_time == resource.data.arrival_time);
    }

    function isValidReservationCreate() {
      let trip = get(request.resource.data.trip_id);
      return request.auth == null
        && request.resource.data.trip_id is path
        && request.resource.data.reservation_time == request.time
        && request.resource.data.phone_number is string
        && request.resource.data.phone_number.size() > 0
        && request.resource.data.qr_data is string
        && request.resource.data.qr_data.size() > 0
        && request.resource.data.status == 'waiting-boarding'
        && request.resource.data.pickup_location is string
        && request.resource.data.pickup_location.size() > 0
        && exists(request.resource.data.trip_id)
        && (trip.data.status == 'Waiting-Passengers'
          || trip.data.status == 'On-the-way')
        && isValidReservationPickup(trip);
    }

    function isValidReservationPickup(trip) {
      let tripStatus = trip.data.status;
      let hasCoordinates = 'pickup_coordinates' in request.resource.data
        && request.resource.data.pickup_coordinates is latlng;

      return tripStatus == 'Waiting-Passengers'
        && !hasCoordinates
        || tripStatus == 'On-the-way'
        && (!('pickup_coordinates' in request.resource.data) || hasCoordinates);
    }

    function isValidPaymentCreate() {
      return request.auth == null
        && request.resource.data.reservation_id is path
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.payment_status == 'completed'
        && request.resource.data.payment_time == request.time;
    }

    function isDriverFcmTokenUpdate() {
      return isDriver()
        && request.auth.uid == driverId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['fcm_token', 'fcm_token_updated_at'])
        && request.resource.data.fcm_token is string
        && request.resource.data.fcm_token.size() > 0
        && request.resource.data.fcm_token_updated_at == request.time
        && request.resource.data.email == resource.data.email
        && request.resource.data.name == resource.data.name
        && request.resource.data.phone_number == resource.data.phone_number
        && request.resource.data.status == resource.data.status;
    }

    function isDriverBoardReservationUpdate() {
      let trip = get(resource.data.trip_id);
      let tripStatus = trip.data.status;
      let hasCoordinates = 'pickup_coordinates' in resource.data
        && resource.data.pickup_coordinates is latlng;

      return isDriver()
        && isTripDriver(trip.data)
        && (tripStatus == 'Waiting-Passengers' || tripStatus == 'On-the-way')
        && resource.data.status == 'waiting-boarding'
        && request.resource.data.status == 'Boarded'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.trip_id == resource.data.trip_id
        && request.resource.data.reservation_time == resource.data.reservation_time
        && request.resource.data.phone_number == resource.data.phone_number
        && request.resource.data.qr_data == resource.data.qr_data
        && request.resource.data.pickup_location == resource.data.pickup_location
        && (!hasCoordinates
          || request.resource.data.pickup_coordinates == resource.data.pickup_coordinates);
    }

    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if isAdmin();
    }

    match /drivers/{driverId} {
      allow read: if request.auth != null
        && (request.auth.uid == driverId || isAdmin());
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isDriverFcmTokenUpdate();
    }

    match /buses/{id} {
      allow read: if resource.data.status == 'active';
      allow read: if isAdmin();
      allow read: if isDriver() && resource.data.driver_id == driverRef();
      allow write: if isAdmin();
    }

    match /routes/{id} {
      allow read: if resource.data.status == 'active';
      allow read: if request.auth != null && (isAdmin() || isDriver());
      allow write: if isAdmin();
    }

    match /Trips/{id} {
      allow read: if resource.data.status == 'Waiting-Passengers';
      allow read: if resource.data.status == 'On-the-way';
      allow read: if request.auth != null;
      allow create: if isDriver() && isWaitingPassengersCreate();
      allow update: if (isDriver()
        && isTripDriver(resource.data)
        && (isStartTripUpdate() || isCompleteTripUpdate()))
        || isGuestBookingUpdate();
      allow delete: if isAdmin();
    }

    match /bus_location/{locationId} {
      allow read: if request.auth == null;
      allow read: if request.auth != null;
      allow create: if isDriver()
        && request.resource.data.bus_id is path
        && request.resource.data.location is latlng
        && request.resource.data.timestamp is timestamp
        && get(request.resource.data.bus_id).data.driver_id == driverRef();
      allow update, delete: if isAdmin();
    }

    match /Reservation/{id} {
      allow read: if true;
      allow create: if isValidReservationCreate();
      allow update: if isAdmin() || isDriverBoardReservationUpdate();
      allow delete: if isAdmin();
    }

    match /Payment/{id} {
      allow read: if true;
      allow create: if isValidPaymentCreate();
      allow update, delete: if isAdmin();
    }
  }
}
